cat > .gitignore <<'EOF'
# Python
__pycache__/
*.py[cod]
*.so

# Virtual environment
.venv/
venv/
env/

# Environment variables
.env

# Testing
.pytest_cache/
.coverage
htmlcov/

# Data
data/raw/
data/processed/
*.parquet
*.csv

# FastF1 cache
cache/

# IDE
.vscode/

# macOS
.DS_Store

# Logs
*.log
EOF